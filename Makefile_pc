C_SUBDIR        = src
GFLIB_SUBDIR    = gflib
ASM_SUBDIR      = asm
DATA_SRC_SUBDIR = src/data
DATA_ASM_SUBDIR = data
SONG_SUBDIR     = sound/songs
MID_SUBDIR      = sound/songs/midi

C_BUILDDIR        = $(OBJ_DIR)/$(C_SUBDIR)
GFLIB_BUILDDIR    = $(OBJ_DIR)/$(GFLIB_SUBDIR)
ASM_BUILDDIR      = $(OBJ_DIR)/$(ASM_SUBDIR)
DATA_ASM_BUILDDIR = $(OBJ_DIR)/$(DATA_ASM_SUBDIR)
SONG_BUILDDIR     = $(OBJ_DIR)/$(SONG_SUBDIR)
MID_BUILDDIR      = $(OBJ_DIR)/$(MID_SUBDIR)

# ---- Assembler flags ---------------------------------------------------------
ASFLAGS := --32 --defsym MODERN=$(MODERN) --defsym PORTABLE=1 --defsym UBFIX=1

# ---- Compiler flags ----------------------------------------------------------
GCC_VER := $(shell $(CC) -dumpversion)

# CC1 is used on Windows for the cc1 -> as pipeline.
# On Linux we use 'gcc -c -x cpp-output' instead, so CC1 is not needed.
ifeq ($(HOST_OS),windows)
  CC1 := $(shell $(CC) --print-prog-name=cc1) -quiet
endif

# Common C flags for both platforms
COMMON_CFLAGS := -Wno-trigraphs -Wimplicit -Wparentheses -Wunused -m32 \
    -std=gnu99 -fno-dce -fno-builtin -Wno-unused-function \
    -DPORTABLE -DNONMATCHING -DUBFIX -DMODERN=$(MODERN)

ifeq ($(HOST_OS),windows)
  # Windows PE/COFF needs leading underscores on C symbols
  override CFLAGS += $(COMMON_CFLAGS) -fleading-underscore
else
  # Linux ELF: no leading underscore
  override CFLAGS += $(COMMON_CFLAGS)
endif

CPPFLAGS := -iquote include -iquote $(GFLIB_SUBDIR) -Wno-trigraphs \
    -DNONMATCHING -DPORTABLE -D$(TARGET_PLATFORM) -D$(TILE_RENDERER) \
    -DMODERN=$(MODERN) -DUBFIX -DTESTING=$(TEST) -D$(GAME_VERSION) \
    $(SDL_CFLAGS)

ifeq ($(DINFO),1)
  override CFLAGS += -g -O0
else
  override CFLAGS += -O3
endif

# ---- Linker flags ------------------------------------------------------------
PLATFORM_LIBS :=

ifeq ($(HOST_OS),windows)
  ifneq ($(NO_STD_LIB),1)
    PLATFORM_LIBS += -lmingw32
  endif
  ifeq ($(TARGET_PLATFORM),PLATFORM_SDL2)
    PLATFORM_LIBS += -lSDL2main -lSDL2.dll
  endif
  ifeq ($(TARGET_PLATFORM),PLATFORM_WIN32)
    ifeq ($(NO_STD_LIB),1)
      PLATFORM_LIBS += -Wl,-e__main -nostdlib
      CPPFLAGS += -DNO_STD_LIB_ENABLED
    endif
    PLATFORM_LIBS += -lkernel32 -luser32 -lgdi32
  endif
  PLATFORM_LIBS += -lwinmm -lxinput
else
  # Linux
  ifeq ($(TARGET_PLATFORM),PLATFORM_SDL2)
    PLATFORM_LIBS += $(SDL_LDFLAGS)
  endif
  PLATFORM_LIBS += -lm -lpthread
endif

LIB := $(LIBPATH) -lgcc -lc

