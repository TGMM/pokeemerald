# =============================================================================
# Makefile_pc — PC platform build for pokeemerald
# Supports: Linux (native, 32-bit), Windows (mingw32 cross-compile)
# =============================================================================

# ---- Host / cross-compile detection ----------------------------------------
# Set CROSS=mingw32 to force Windows cross-compile from Linux.
# Otherwise, auto-detect: native on Linux, mingw32 on Windows.

ifeq ($(CROSS),mingw32)
  # Cross-compiling for Windows from Linux
  PREFIX := i686-w64-mingw32-
  HOST_OS := windows
  # Build tools run on the host (Linux), so no .exe extension
  HOST_EXE :=
else ifeq ($(OS),Windows_NT)
  # Native Windows build (MSYS2/MinGW)
  PREFIX := i686-w64-mingw32-
  HOST_OS := windows
  HOST_EXE := .exe
else
  # Native Linux build
  PREFIX :=
  HOST_OS := linux
  HOST_EXE :=
endif

OBJCOPY := $(PREFIX)objcopy
CC      := $(PREFIX)gcc
AS      := $(PREFIX)as

export LD  := $(PREFIX)ld

# On Linux, use 'gcc -E -m32' as preprocessor to get correct multilib headers.
# On Windows, bare cpp is fine since the mingw32 toolchain is natively 32-bit.
ifeq ($(HOST_OS),linux)
  export CPP := $(CC) -E -m32
  # For piped data assembly, CPP must read from stdin:
  DATA_CPP = $(CPP) -x assembler-with-cpp -
else
  export CPP := $(PREFIX)cpp
  DATA_CPP = $(CPP)
endif

# ---- ASM directive conversion (GBA → x86/PE) --------------------------------
# Convert ARM assembly directives to x86 equivalents and strip ARM-style
# comments (@ to end of line) which are invalid on x86.
# Four sed expressions:
#   1. Convert .4byte/.2byte/.word to .int/.short/.int (x86 equivalents)
#   2. Strip ARM section types (%progbits/%note) — x86 as uses @progbits but
#      our @ stripping would eat it, and the assembler defaults correctly anyway
#   3. Strip inline @ comments (preceded by whitespace)
#   4. Delete full-line @ comments (line starts with optional whitespace then @)
ASM_PSEUDO_OP_CONV := sed -e 's/\.4byte/.int/g;s/\.2byte/.short/g;s/\.word\b/.int/g' -e 's/,[[:space:]]*%progbits//' -e 's/,[[:space:]]*%note//' -e 's/[[:space:]]@.*//' -e '/^[[:space:]]*@/d'

# FIX_UNDERSCORE is required for 32-bit Windows PE/COFF (leading _ convention).
# On Linux ELF, symbols have no leading underscore, so this must be a no-op.
ifeq ($(HOST_OS),windows)
  FIX_UNDERSCORE := $(OBJCOPY) --prefix-symbol _
else
  FIX_UNDERSCORE := @true
endif

# ---- Platform / SDL2 --------------------------------------------------------
TARGET_PLATFORM := PLATFORM_SDL2
TILE_RENDERER   := RENDERER_EASY_DRAW

ifeq ($(HOST_OS),linux)
  # Use pkg-config for SDL2. User must have libsdl2-dev:i386 installed for -m32.
  SDL_CFLAGS  := $(shell PKG_CONFIG_PATH=/usr/lib/i386-linux-gnu/pkgconfig pkg-config --cflags sdl2 2>/dev/null)
  SDL_LDFLAGS := $(shell PKG_CONFIG_PATH=/usr/lib/i386-linux-gnu/pkgconfig pkg-config --libs sdl2 2>/dev/null)
else
  # Windows: point SDL_DIR at your i686 SDL2 development tree
  SDL_DIR     ?= $(CURDIR)/../SDL2-mingw32
  SDL_CFLAGS  := -I$(SDL_DIR)/include
  SDL_LDFLAGS := -L$(SDL_DIR)/lib
endif

# ---- EXE extension -----------------------------------------------------------
# TARGET_EXE: extension for the output binary (.exe for Windows target)
# HOST_EXE:   extension for build tools (set above; empty when cross-compiling)
# EXE:        used in tool path definitions (must match host, not target)
ifeq ($(HOST_OS),windows)
  TARGET_EXE := .exe
else
  TARGET_EXE :=
endif

EXE := $(HOST_EXE)

