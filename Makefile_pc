# ---- C source compilation ----------------------------------------------------
# Pipeline: CPP (preprocess) -> preproc (charmap transform) -> compile to .o
#
# On Linux, we use 'gcc -m32 -c -x cpp-output' to compile the preprocessed
# output directly. This avoids cc1 multilib header issues and the extra
# assembly step.
#
# On Windows, we keep the original cc1 -> as pipeline since the mingw32
# toolchain doesn't have these issues.

ifeq ($(NODEP),1)
$(C_BUILDDIR)/%.o: c_dep :=
else
$(C_BUILDDIR)/%.o: c_dep = $(shell [[ -f $(C_SUBDIR)/$*.c ]] && $(SCANINC) -I include -I $(TOOLS_DIR)/agbcc/include -I gflib $(C_SUBDIR)/$*.c)
endif

ifeq ($(HOST_OS),linux)
$(C_BUILDDIR)/%.o : $(C_SUBDIR)/%.c $$(c_dep)
	@$(CPP) $(CPPFLAGS) $< -o $(C_BUILDDIR)/$*.i
	@$(PREPROC) $(C_BUILDDIR)/$*.i charmap.txt > $(C_BUILDDIR)/$*.pp.i
	$(CC) $(CFLAGS) -c -x cpp-output $(C_BUILDDIR)/$*.pp.i -o $@
else
$(C_BUILDDIR)/%.o : $(C_SUBDIR)/%.c $$(c_dep)
	@$(CPP) $(CPPFLAGS) $< -o $(C_BUILDDIR)/$*.i
	@$(PREPROC) $(C_BUILDDIR)/$*.i charmap.txt | $(CC1) $(CFLAGS) -o $(C_BUILDDIR)/$*.s
	@echo -e ".text\n\t.align\t2, 0\n" >> $(C_BUILDDIR)/$*.s
	$(AS) $(ASFLAGS) -o $@ $(C_BUILDDIR)/$*.s
endif

ifeq ($(NODEP),1)
$(GFLIB_BUILDDIR)/%.o: c_dep :=
else
$(GFLIB_BUILDDIR)/%.o: c_dep = $(shell [[ -f $(GFLIB_SUBDIR)/$*.c ]] && $(SCANINC) -I include -I $(TOOLS_DIR)/agbcc/include -I gflib $(GFLIB_SUBDIR)/$*.c)
endif

ifeq ($(HOST_OS),linux)
$(GFLIB_BUILDDIR)/%.o : $(GFLIB_SUBDIR)/%.c $$(c_dep)
	@$(CPP) $(CPPFLAGS) $< -o $(GFLIB_BUILDDIR)/$*.i
	@$(PREPROC) $(GFLIB_BUILDDIR)/$*.i charmap.txt > $(GFLIB_BUILDDIR)/$*.pp.i
	$(CC) $(CFLAGS) -c -x cpp-output $(GFLIB_BUILDDIR)/$*.pp.i -o $@
else
$(GFLIB_BUILDDIR)/%.o : $(GFLIB_SUBDIR)/%.c $$(c_dep)
	@$(CPP) $(CPPFLAGS) $< -o $(GFLIB_BUILDDIR)/$*.i
	@$(PREPROC) $(GFLIB_BUILDDIR)/$*.i charmap.txt | $(CC1) $(CFLAGS) -o $(GFLIB_BUILDDIR)/$*.s
	@echo -e ".text\n\t.align\t2, 0\n" >> $(GFLIB_BUILDDIR)/$*.s
	$(AS) $(ASFLAGS) -o $@ $(GFLIB_BUILDDIR)/$*.s
endif

# ---- Pre-process assembly includes for x86 -----------------------------------
# ARM assembly uses '@' for comments, which x86 'as' doesn't understand.
# Also convert .4byte/.2byte to .int/.short.
#
# Problem: .include directives are resolved by 'as' directly, bypassing any
# sed pipeline. Solution: pre-process ALL includable .s/.inc files into the
# build directory, then run 'as' from within $(OBJ_DIR) so that .include
# finds the pre-processed copies first (CWD takes priority). We pass
# -I $(CURDIR) as fallback for any files not in the pre-processed tree.

# Directories containing files that are .include'd by assembly sources.
PREPROC_ASM_DIRS := sound data asm constants

# Find all .s and .inc files in those directories.
PREPROC_ASM_SRC := $(shell find $(PREPROC_ASM_DIRS) \( -name '*.inc' -o -name '*.s' \) -type f)

# Target paths in the build directory (mirrors the source tree).
PREPROC_ASM_DST := $(addprefix $(OBJ_DIR)/,$(PREPROC_ASM_SRC))

# Stamp file to track when preprocessing is complete.
PREPROC_ASM_STAMP := $(OBJ_DIR)/.preproc_asm_done

# Rule: pre-process all assembly include files in parallel via a single
# shell invocation (much faster than individual make rules for ~3000 files).
$(PREPROC_ASM_STAMP): $(PREPROC_ASM_SRC)
	@echo "Pre-processing $(words $(PREPROC_ASM_SRC)) assembly files for x86..."
	@find $(PREPROC_ASM_DIRS) \( -name '*.inc' -o -name '*.s' \) -type f | \
		while read -r f; do \
			mkdir -p "$(OBJ_DIR)/$$(dirname "$$f")" && \
			sed -e 's/\.4byte/.int/g;s/\.2byte/.short/g;s/\.word\b/.int/g' -e 's/,[[:space:]]*%progbits//' -e 's/,[[:space:]]*%note//' -e 's/[[:space:]]@.*//' -e '/^[[:space:]]*@/d' "$$f" > "$(OBJ_DIR)/$$f"; \
		done
	@touch $@

# Convenience target
preproc_asm: $(PREPROC_ASM_STAMP)

# Helper: run 'as' from within $(OBJ_DIR) so .include finds pre-processed files.
# $(CURDIR) is added as fallback include path for files outside the pre-processed tree.
# Note: pipe into this via: ... | $(AS_IN_BUILDDIR) -o <abs-path> -)
# The opening paren creates a subshell so 'as' reads stdin (not 'cd').
# Caller MUST add the closing ')' after the command.
AS_IN_BUILDDIR = (cd $(CURDIR)/$(OBJ_DIR) && $(AS) $(ASFLAGS) -I $(CURDIR)

# ---- Assembly source rules ---------------------------------------------------

ifeq ($(NODEP),1)
$(ASM_BUILDDIR)/%.o: $(ASM_SUBDIR)/%.s $(PREPROC_ASM_STAMP)
	$(ASM_PSEUDO_OP_CONV) $(CURDIR)/$< | $(AS_IN_BUILDDIR) -o $(CURDIR)/$@ -)
	$(FIX_UNDERSCORE) $@
else
define ASM_DEP
$1: $2 $$(shell $(SCANINC) -I include -I "" $2) $(PREPROC_ASM_STAMP)
	$$(ASM_PSEUDO_OP_CONV) $$(CURDIR)/$$< | $$(AS_IN_BUILDDIR) -o $$(CURDIR)/$$@ -)
	$$(FIX_UNDERSCORE) $$@
endef
$(foreach src, $(ASM_SRCS), $(eval $(call ASM_DEP,$(patsubst $(ASM_SUBDIR)/%.s,$(ASM_BUILDDIR)/%.o, $(src)),$(src))))
endif

# ---- Data assembly rules -----------------------------------------------------

ifeq ($(NODEP),1)
$(DATA_ASM_BUILDDIR)/%.o: $(DATA_ASM_SUBDIR)/%.s $(PREPROC_ASM_STAMP)
	$(PREPROC) $< charmap.txt | $(DATA_CPP) -I include | $(PREPROC) -ie $< charmap.txt | $(ASM_PSEUDO_OP_CONV) | $(AS_IN_BUILDDIR) -o $(CURDIR)/$@ -)
	$(FIX_UNDERSCORE) $@
else
define DATA_ASM_DEP
$1: $2 $$(shell $(SCANINC) -I include -I "" $2) $(PREPROC_ASM_STAMP)
	$$(PREPROC) $$< charmap.txt | $$(DATA_CPP) -I include | $$(PREPROC) -ie $$< charmap.txt | $$(ASM_PSEUDO_OP_CONV) | $$(AS_IN_BUILDDIR) -o $$(CURDIR)/$$@ -)
	$$(FIX_UNDERSCORE) $$@
endef
$(foreach src, $(REGULAR_DATA_ASM_SRCS), $(eval $(call DATA_ASM_DEP,$(patsubst $(DATA_ASM_SUBDIR)/%.s,$(DATA_ASM_BUILDDIR)/%.o, $(src)),$(src))))
$(foreach src, $(C_ASM_SRCS), $(eval $(call DATA_ASM_DEP,$(patsubst $(C_SUBDIR)/%.s,$(C_BUILDDIR)/%.o, $(src)),$(src))))
endif

# ---- Song / MIDI assembly rules ---------------------------------------------
# Static pattern rules override the implicit rules from audio_rules.mk.

$(SONG_OBJS): $(SONG_BUILDDIR)/%.o: $(SONG_SUBDIR)/%.s $(PREPROC_ASM_STAMP)
	$(ASM_PSEUDO_OP_CONV) $(CURDIR)/$< | $(AS_IN_BUILDDIR) -I sound -o $(CURDIR)/$@ -)
	$(FIX_UNDERSCORE) $@

$(MID_OBJS): $(MID_BUILDDIR)/%.o: $(MID_SUBDIR)/%.s $(PREPROC_ASM_STAMP)
	$(ASM_PSEUDO_OP_CONV) $(CURDIR)/$< | $(AS_IN_BUILDDIR) -I sound -o $(CURDIR)/$@ -)
	$(FIX_UNDERSCORE) $@

# ---- Linker script generation (not used by default link rule) ----------------

$(OBJ_DIR)/sym_bss.ld: sym_bss.txt
	$(RAMSCRGEN) .bss $< ENGLISH > $@

$(OBJ_DIR)/sym_common.ld: sym_common.txt $(C_OBJS) $(wildcard common_syms/*.txt)
	$(RAMSCRGEN) COMMON $< ENGLISH -c $(C_BUILDDIR),common_syms > $@

$(OBJ_DIR)/sym_ewram.ld: sym_ewram.txt
	$(RAMSCRGEN) ewram_data $< ENGLISH > $@

# ---- Final link --------------------------------------------------------------
# Link with gcc driver (handles CRT, stdlib). No custom linker script needed
# since this is a regular userspace executable, not a GBA ROM.

$(ROM): $(OBJS)
ifeq ($(HOST_OS),windows)
	$(CC) $(CFLAGS) -Wl,--demangle $^ -static-libgcc -L$(SDL_DIR)/lib $(PLATFORM_LIBS) -o $@
else
	$(CC) $(CFLAGS) $^ $(PLATFORM_LIBS) -o $@
endif
